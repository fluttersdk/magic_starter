import 'package:flutter/material.dart';
import 'package:magic/magic.dart';
import 'package:magic_starter/magic_starter.dart';
import '../models/user.dart';
{{ teams_import }}

/// Application Service Provider.
///
/// Bootstraps Magic Starter by registering user model, navigation, logout,
/// locale options, and any optional feature integrations (teams, social login,
/// notifications). Call order matters: the user factory must be set before any
/// Auth restoration attempt.
class AppServiceProvider extends ServiceProvider {
    AppServiceProvider(super.app);

    @override
    void register() {
        // Bind your application services here (sync only, do not resolve other
        // services or call facades in this method).
    }

    @override
    Future<void> boot() async {
        // 1. Register user factory so Auth.user<User>() returns your model and
        //    session restoration works after token refresh.
        Auth.manager.setUserFactory((data) => User.fromMap(data));

        // 2. Register the starter's identity contract in ONE call: the user
        //    model its profile/team views receive, what logging out does, and
        //    which locales the language picker offers. bootstrap() makes these
        //    required arguments, so none of them can be forgotten silently
        //    (a missing user factory used to fall back to the starter's own
        //    user type while every screen kept rendering).
        MagicStarter.bootstrap(
            userFactory: (data) => User.fromMap(data),
            onLogout: () async {
                await Auth.logout();
                MagicRoute.to(MagicStarterConfig.loginRoute());
            },
            locales: {
                'en': 'English',
            },
{{ team_params }}        );

        // 3. Register navigation items for both the desktop sidebar (mainItems)
        //    and the mobile bottom bar (bottomItems).
        MagicStarter.useNavigation(
            mainItems: [
                MagicStarterNavItem(
                    icon: Icons.dashboard_outlined,
                    labelKey: 'nav.dashboard',
                    path: MagicStarterConfig.homeRoute(),
                ),
                MagicStarterNavItem(
                    icon: Icons.settings_outlined,
                    labelKey: 'nav.settings',
                    path: MagicStarterConfig.profileRoute(),
                ),
            ],
            bottomItems: [
                MagicStarterNavItem(
                    icon: Icons.dashboard_outlined,
                    labelKey: 'nav.dashboard',
                    path: MagicStarterConfig.homeRoute(),
                ),
                MagicStarterNavItem(
                    icon: Icons.settings_outlined,
                    labelKey: 'nav.settings',
                    path: MagicStarterConfig.profileRoute(),
                ),
            ],
        );

{{ social_login_block }}
{{ notifications_block }}

        // -- Theme Customization (uncomment to customize) -------------------------
        // MagicStarter.useTheme(
        //   MagicStarterTheme(
        //     form: MagicStarterFormTheme(
        //       inputClassName: 'w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700',
        //       primaryButtonClassName: 'w-full bg-primary hover:bg-primary/80 text-white text-base font-semibold py-3 rounded-lg',
        //     ),
        //     card: MagicStarterCardTheme(
        //       surfaceClassName: 'bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700',
        //     ),
        //   ),
        // );

        // -------------------------------------------------------------------
        // State Registration (optional, for eager initialization)
        // -------------------------------------------------------------------
        // Most state classes should use the lazy singleton pattern with a
        // static accessor instead of registering here:
        //
        //   class ProjectState extends MagicController
        //       with MagicStateMixin<List<Project>> {
        //     static ProjectState get instance =>
        //         Magic.findOrPut(ProjectState.new);
        //   }
        //
        // Only register here if the state needs to be ready before any view
        // renders (e.g., WebSocket connection, auth-dependent init):
        //
        //   Magic.findOrPut(DashboardState.new);
        //
        // See the Magic Starter package documentation/repository for the
        // controller architecture guide.
    }
}
